# Copy to .env and fill in. Never commit .env.
# INSTRUCTIONS.md §12: every key named here, no values.
#
# Keys are grouped by the phase that first consumes them. config.py only
# declares what the current phase actually uses, so a key listed here but not
# yet in config.py is a forward declaration, not dead config.

# ---- Phase 0: service ----
ENV=dev                      # dev | prod
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
HOST=127.0.0.1
PORT=8000

# Exact origins, comma separated. No wildcards — config.py rejects them (§3.5).
# Applies to CORS and, from Phase 1, to the WebSocket Origin check.
ALLOWED_ORIGINS=

# Reverse proxies whose X-Forwarded-For we trust (§4.2).
TRUSTED_PROXIES=127.0.0.1

# ---- Phase 1: LLM ----
GROQ_API_KEY=

# ---- Phase 2: TTS ----
# Optional. Without it the TTS chain starts at edge-tts.
FISH_API_KEY=

# ---- Phase 4: persistence ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Signing key for conversation resume tokens (§10 Phase 4).
# Generate with: openssl rand -hex 32
RESUME_TOKEN_SECRET=

# ---- Ops ----
# Used by the cron that keeps the DuckDNS record current.
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=
